{
  "name": "nori-chan-koinu",
  "private": true,
  "version": "1.0.0",
  "description": "のりちゃん × こいぬ — Koinu Korokoro! A kawaii sushi-town arcade game and $SUSHI companion site.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && vite build",
    "test:premium-build": "node scripts/check-premium-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
